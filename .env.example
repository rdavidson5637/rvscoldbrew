# Public site URL (used for sitemap, Open Graph, JSON-LD, checkout redirects)
NEXT_PUBLIC_SITE_URL=https://rvscoldbrew.com

# Replace with your real in-store Spotify playlist ID
# NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID=your_playlist_id_here

# Square (server-only — never prefix with NEXT_PUBLIC_)
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
